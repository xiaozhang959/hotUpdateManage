# Production template. Copy values into your deployment platform secrets or .env.production.

# ==========================================
# Database: PostgreSQL is recommended for production
# ==========================================
DB_PROVIDER=postgresql
POSTGRESQL_URL=postgresql://user:password@host:5432/hot_update_manager
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/hot_update_manager
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/hot_update_manager
DATABASE_URL_NON_POOLING=postgresql://user:password@host:5432/hot_update_manager
DATABASE_URL=postgresql://user:password@host:5432/hot_update_manager

# ==========================================
# Auth and public URL
# ==========================================
NEXTAUTH_URL=https://your-domain.example.com
NEXTAUTH_SECRET=replace-with-strong-random-secret
AUTH_SECRET=replace-with-strong-random-secret
HOT_UPDATE_BOOTSTRAP_TOKEN=replace-with-strong-random-bootstrap-token
HOT_UPDATE_INTERNAL_TOKEN=replace-with-strong-random-internal-token

# Optional fixed RSA key pair for encrypted password requests.
AUTH_TRANSPORT_PUBLIC_KEY_PEM=
AUTH_TRANSPORT_PRIVATE_KEY_PEM=
AUTH_REQUEST_MAX_AGE_MS=120000

# ==========================================
# External storage is recommended for production
# ==========================================
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
UPLOAD_SESSION_SECRET=replace-with-strong-random-upload-session-secret
NEXT_PUBLIC_UPLOAD_CHUNK_THRESHOLD_MB=60
NEXT_PUBLIC_UPLOAD_RESUME_TTL_HOURS=72
UPLOAD_SESSION_TTL_HOURS=72

# ==========================================
# Cache and runtime
# ==========================================
REDIS_URL=
VERSION_CACHE_TTL=60
ROTATION_BATCH_SIZE=100
INIT_CACHE_TTL=3600
INIT_CACHE_STALE=300000
CACHE_MONITORING_ENABLED=false
CACHE_LOG_LEVEL=info
TZ=Asia/Shanghai
NEXT_PUBLIC_TZ=Asia/Shanghai

# ==========================================
# Optional SMTP
# ==========================================
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=noreply@example.com
