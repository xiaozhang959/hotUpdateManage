# ==========================================
# 数据库配置选项
# ==========================================

# 数据库类型选择：sqlite | postgresql | mysql
DB_PROVIDER=sqlite


# Prisma 实际读取的数据库连接串；本地 SQLite 默认值如下
DATABASE_URL=file:./dev.db

# ==========================================
# SQLite 配置（本地开发）
# ==========================================
# SQLite 数据库文件路径
SQLITE_URL=file:./dev.db

# ==========================================
# PostgreSQL 配置（Vercel Postgres / Supabase）
# ==========================================
# Vercel Postgres
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Prisma directUrl 兼容项；通常与 POSTGRES_URL_NON_POOLING 保持一致
DATABASE_URL_NON_POOLING=

# 或者 Supabase / 自建 PostgreSQL
POSTGRESQL_URL=

# ==========================================
# MySQL 配置（PlanetScale / 自建）
# ==========================================
MYSQL_URL=

# ==========================================
# NextAuth 配置
# ==========================================
# 生成密钥: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# 登录请求加密（强烈建议生产环境配置固定 RSA 密钥对，避免多实例/重启后公钥变化）
# 生成方式（PowerShell / Git Bash / Linux 均可）：
# openssl genpkey -algorithm RSA -out auth-transport-private.pem -pkeyopt rsa_keygen_bits:2048
# openssl rsa -pubout -in auth-transport-private.pem -out auth-transport-public.pem
# 再将 PEM 内容按单行写入环境变量（换行替换为 \n）
AUTH_TRANSPORT_PUBLIC_KEY_PEM=
AUTH_TRANSPORT_PRIVATE_KEY_PEM=
# 登录加密请求允许的最大时钟偏移/有效期（毫秒）
AUTH_REQUEST_MAX_AGE_MS=120000

# ==========================================
# 邮件配置（可选）
# ==========================================
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=noreply@example.com

# ==========================================
# 对象存储配置（可选，用于文件上传）
# ==========================================
# AWS S3 / 兼容 S3 的存储服务
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ==========================================
# Redis 配置（可选，用于缓存）
# ==========================================
REDIS_URL=

# ==========================================
# 应用配置
# ==========================================
# 最大文件上传大小（MB）
MAX_FILE_SIZE=100

# API 速率限制（每分钟请求数）
RATE_LIMIT=60

# 是否启用注册功能
ENABLE_REGISTRATION=true

# ==========================================
# 时区配置（可选）
# ==========================================
TZ=Asia/Shanghai
NEXT_PUBLIC_TZ=Asia/Shanghai

# ==========================================
# 上传配置
# ==========================================
# 超过该大小后启用分片上传（MB）
NEXT_PUBLIC_UPLOAD_CHUNK_THRESHOLD_MB=60
# 浏览器端断点续传记录有效期（小时）
NEXT_PUBLIC_UPLOAD_RESUME_TTL_HOURS=72
# 服务端上传会话有效期（小时）
UPLOAD_SESSION_TTL_HOURS=72
# 上传会话签名密钥；生产环境请配置强随机值
UPLOAD_SESSION_SECRET=

# ==========================================
# 缓存配置（可选）
# ==========================================
# 版本信息缓存时间（秒）
VERSION_CACHE_TTL=60
# 轮询索引批量更新阈值
ROTATION_BATCH_SIZE=100
# 初始化数据缓存时间（秒）
INIT_CACHE_TTL=3600
# 初始化数据 stale 时间（毫秒）
INIT_CACHE_STALE=300000
# 是否启用缓存监控日志
CACHE_MONITORING_ENABLED=false
# 缓存日志级别：debug | info | warn | error
CACHE_LOG_LEVEL=info

# ==========================================
# 内部安全令牌（生产环境建议配置）
# ==========================================
# 内部日志接口令牌
HOT_UPDATE_INTERNAL_TOKEN=
# 生产环境启动校验令牌
HOT_UPDATE_BOOTSTRAP_TOKEN=
# NextAuth/Auth.js 兼容密钥；可与 NEXTAUTH_SECRET 保持一致
AUTH_SECRET=
